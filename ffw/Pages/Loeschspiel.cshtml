@page "/loeschspiel"
@model LoeschspielModel
@{
    // Eigenständige Seite ohne das gemeinsame Layout (wie die Kostenuhr).
    // Besucher finden sie nur über die URL /loeschspiel. Angemeldete sehen auf der Startseite einen Link und hier einen Weg zurück.
    Layout = null;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0F2A3D" />
    <title>Löschspiel – Feuerwehr Walting</title>
    <link rel="stylesheet" href="~/css/loeschspiel.css" asp-append-version="true" />
</head>
<body>
    <main class="app">

        <header class="kopf">
            <div class="titel">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="zur-startseite" href="~/">&larr; Startseite</a>
                }
                <h1>Löschspiel</h1>
            </div>
            <div class="anzeigen">
                <div class="anzeige"><span class="beschriftung">Punkte</span><strong id="punkte">0</strong></div>
                <div class="anzeige"><span class="beschriftung">Einsatzdauer</span><strong id="zeit">0:00</strong></div>
                <div class="anzeige"><span class="beschriftung">Rekord</span><strong id="rekord">0</strong></div>
                <button type="button" id="btn-pause" class="knopf knopf-klein">Pause</button>
                <button type="button" id="btn-ton" class="knopf knopf-klein" aria-pressed="true" title="Ton ein- und ausschalten (Taste M)">Ton an</button>
            </div>
        </header>

        <div class="buehne" id="buehne">
            <img class="szene" src="~/images/feuerwehr-hintergrund.jpg" alt="Das Feuerwehrhaus" draggable="false" />
            <canvas class="flaeche" id="flaeche" aria-label="Spielfeld: Brände am Feuerwehrhaus löschen"></canvas>
            <div class="hinweis" id="hinweis" role="status" aria-live="polite" hidden></div>

            <div class="overlay" id="overlay">
                <div class="karte">
                    <h2 id="overlay-titel">Es brennt am Feuerwehrhaus!</h2>
                    <div id="overlay-text">
                        <p>Rund um das Gerätehaus entstehen Brände. Lösche sie, bevor das Gebäude Schaden nimmt.</p>
                        <ul class="anleitung">
                            <li><strong>Zielen:</strong> Maus bewegen oder mit dem Finger in die Nähe des Brandes zeigen, der Strahl peilt ihn dann an.</li>
                            <li><strong>Spritzen:</strong> Maustaste, Leertaste oder Finger gedrückt halten (nicht nur antippen).</li>
                            <li><strong>Wassermenge:</strong> mit dem Regler, dem Mausrad oder den Tasten W/S bzw. Pfeil hoch/runter einstellen.</li>
                            <li><strong>Zu wenig Wasser:</strong> Der Strahl reicht nicht bis zum Brand, oder das Wasser verdampft, ohne zu löschen.</li>
                            <li><strong>Zu viel Wasser:</strong> Der Vorrat ist schnell leer, danach kommt nur noch ein Rinnsal.</li>
                            <li><strong>Punkte</strong> für gelöschte Brände bringen dir bessere Ausrüstung: vom Gartenschlauch zum D-, C- und schließlich B-Rohr.</li>
                        </ul>
                    </div>
                    <button type="button" id="overlay-start" class="knopf knopf-gross">Einsatz starten</button>
                </div>
            </div>
        </div>

        <p class="querformat-tipp">Tipp: Das Smartphone quer halten, dann wird das Spielfeld größer.</p>

        <section class="pult" aria-label="Bedienpult">
            <div class="feld regler">
                <label for="durchfluss">Wassermenge <output id="durchfluss-wert" for="durchfluss">50 %</output></label>
                <input type="range" id="durchfluss" min="0" max="100" step="1" value="50" />
            </div>

            <div class="feld messung">
                <div class="balken">
                    <div class="balken-kopf"><span>Wasser</span><span id="tank-text">100 %</span></div>
                    <div class="spur"><div class="fuellung wasser" id="tank-fuellung"></div></div>
                </div>
                <div class="balken">
                    <div class="balken-kopf"><span>Schaden</span><span id="schaden-text">0 %</span></div>
                    <div class="spur"><div class="fuellung schaden" id="schaden-fuellung"></div></div>
                </div>
            </div>

            <div class="feld ausruestung">
                <div class="geraet-name" id="geraet-name">Gartenschlauch</div>
                <div class="geraet-daten" id="geraet-daten"></div>
                <button type="button" id="btn-upgrade" class="knopf" disabled>Aufrüsten</button>
                <label class="hilfe"><input type="checkbox" id="hilfe-an" checked /> Hinweise an den Bränden</label>
            </div>
        </section>

    </main>

    <script src="~/js/loeschspiel.js" asp-append-version="true"></script>
</body>
</html>
