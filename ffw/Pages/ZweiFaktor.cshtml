@page "/anmelden/zwei-faktor"
@model ZweiFaktorModel
@{
    ViewData["Title"] = "Zwei-Faktor-Anmeldung";
}

@section Styles {
    <link rel="stylesheet" href="~/css/fotos.css" asp-append-version="true" />
}

<div class="login-box">
    <a class="zurueck" asp-page="/Anmelden">&larr; Zurück zur Anmeldung</a>
    <h1>Bestätigungscode</h1>
    <p class="text-muted">
        Bitte den 6-stelligen Code aus deiner Authenticator-App eingeben.
    </p>

    <form method="post" asp-route-returnUrl="@Model.ReturnUrl" asp-route-rememberMe="@Model.RememberMe">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="Input.Code" class="form-label">Code</label>
            <input asp-for="Input.Code" class="form-control" inputmode="numeric" autocomplete="one-time-code" autofocus />
            <span asp-validation-for="Input.Code" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-danger w-100">Bestätigen</button>
    </form>

    <p class="small mt-3 mb-0">
        <a asp-page="/Wiederherstellung" asp-route-returnUrl="@Model.ReturnUrl">Stattdessen einen Wiederherstellungscode verwenden</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
