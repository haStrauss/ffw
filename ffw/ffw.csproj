<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>2ac389d8-3edf-428e-9163-1a253f40979d</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <!-- ImageSharp 4.x prüft beim Build eine Six-Labors-Lizenz (kostenlose Community-Lizenz von licensing.sixlabors.com).
       Der Schlüssel kommt aus der Umgebungsvariable SIXLABORS_LICENSE_KEY und gehört nie ins Repository.
       Ohne Variable greift Six Labors weiter auf eine lokale sixlabors.lic neben dieser Datei zurück. -->
  <PropertyGroup Condition="'$(SIXLABORS_LICENSE_KEY)' != ''">
    <SixLaborsLicenseKey>$(SIXLABORS_LICENSE_KEY)</SixLaborsLicenseKey>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.*" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.*" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
  </ItemGroup>

</Project>
